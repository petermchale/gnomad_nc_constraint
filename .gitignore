__pycache__/
*.pyc
# Downloaded copies of Chen et al.'s published data (~8 GB). Regenerable, but over
# hours -- every script here re-downloads on demand. Named `published/` rather than
# `tmp/` precisely so it does not read as disposable. $GNOCCHI_PUBLISHED_DIR moves it
# out of the checkout entirely (shared lab space on a cluster).
published/
.DS_Store
# The regional-adjustment refits (~12 GB), ONE copy read directly by fig5/ and
# dnm_training_size/. Regenerated by fig5/refit.py -population {full,scored,sizematched}.
refits/
# Paper PDFs -- reference copies, not repo content, and not ours to redistribute.
chen_et_al_2024.pdf
mchale_et_al_250115.pdf
mchale_et_al_supporting_250115.pdf
# Large regenerable outputs of the DNM training-set-size experiment (multi-GB).
# The small binned/summary tables and the PDFs ARE tracked -- they are what the
# figures and the manuscript cite.
dnm_training_size/output/rr_by_context.*
dnm_training_size/output/expected_counts_by_context_methyl_genome_1kb.dnm_refit_*.txt
dnm_training_size/output/training_reliability_predictions.*

# Fig. 3's panel-A cache: regenerable from the public bucket in a few minutes.
fig3/output/panelA_binned_ranks.parquet
# 81 MB per-window intermediate; regenerated by fig3/make_r_figures.py in ~5 s
fig3/output/r_eff_components.parquet
# 4 GB per-(window, context) r from the restricted refit; regenerated by
# fig3/refit_restricted.py in ~6 min. The 127 MB expected-count table it feeds
# is also regenerable and large.
fig3/output/rr_by_context.*
fig3/output/expected_counts_by_context_methyl_genome_1kb.*.txt
# 100+ MB per-site prediction table; regenerated by fig3/plot_dnm_probability_pairs.py
fig3/output/training_reliability_predictions.*

# Fig. 5's only large intermediate (81 MB per-window r_eff components; the refit
# tables themselves live in refits/, ignored above). Regenerated in ~5 s from the
# cached bucket files. The panel PDFs and the small binned tables ARE tracked.
fig5/output/r_eff_components.*.parquet

.trash
