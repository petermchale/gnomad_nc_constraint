// Silence Pylance/pyright's type complaints about duckdb and pandas, which are noise here,
// while keeping the diagnostics that catch real mistakes.
//
// 17 errors are turned off. Most come from a third-party stub being more conservative than
// the value actually is:
//
//   1. duckdb's `fetchone()` is typed `tuple | None`, so `n, = con.execute(...).fetchone()`
//      reads as unpacking None (verify_training_set_counts.py:194, validate.py:230,
//      verify_expected_r1.py:165/191). A `SELECT COUNT(*)` always returns a row; the None
//      branch is unreachable by construction.
//   2. duckdb scalars come back as `PythonLiteral | None`, so passing one to `float()` or
//      comparing it to a number looks unsafe (fig5/data.py, fig5/depletion_rank.py).
//   3. pandas-stubs cannot type `df.apply(scipy.stats.zscore)` (dnm_model.py:260), since
//      zscore's signature does not match the `(...) -> Mapping` overload it picks.
//
// Four are ours rather than the stubs': two defaults that should be a Sequence or a list --
// `extra: list[tuple[str, str]] = ()` and `dims: list[tuple[str, str]] = ()`, both now in
// fig5/data.py -- and `total_size += size` in list_bucket_files.py:237/244, where `size` is `int | None` in general but never
// None on those two paths. All four are harmless at runtime and worth fixing properly rather
// than leaving to a blanket suppression.
//
// Disabled per rule rather than with `typeCheckingMode: "off"` so that the checks worth
// having survive -- reportUndefinedVariable and reportUnboundVariable in particular, which
// catch typos in a repo that is mostly scripts, and unresolved imports.
//
// If you add a real type annotation somewhere and want it enforced, delete the matching line
// below rather than the whole file.
{
  // So `uvx pyright` from the shell resolves duckdb/pandas the same way the editor does.
  // Without this it reports 28 spurious unresolved-import errors instead.
  "venvPath": ".",
  "venv": ".venv",

  // Chen et al.'s files are byte-unchanged from upstream (see README) and ours to read, not
  // to fix; the two data directories are gitignored downloads.
  //
  // The first three entries are pyright's own defaults, restored by hand: naming `exclude`
  // at all REPLACES the defaults rather than adding to them, and dropping `**/.*` sends
  // pyright walking into `.venv` (which is minutes of analysis, and is what Pylance's
  // `missingDefaultExcludes` hint is warning about).
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "published",
    "refits",
    "run_nc_constraint_gnomad_v31_main.py",
    "analyze_individual_feature_effects.py",
    "generate_manuscript_figures.py",
    "generate_manuscript_efigures.py",
    "fig_utils.py",
    "efig_utils.py",
    "generic.py",
    "constraint_basics.py",
    "nc_constraint_utils.py"
  ],

  "typeCheckingMode": "basic",

  // reportAttributeAccessIssue, reportOptionalIterable and reportReturnType were here too,
  // for a `df[['a','b']]` union that included ndarray. Installing pandas-stubs (pinned to
  // the pandas version in requirements.txt) types those frames as frames, and all three
  // rules now find nothing, so they are enforced again.
  "reportOptionalSubscript": "none",
  "reportGeneralTypeIssues": "none",
  "reportArgumentType": "none",
  "reportOperatorIssue": "none",
  "reportCallIssue": "none"
}
